#!/usr/bin/env fish

# ================= 配置区域 =================
# 1. 本地处理后的音乐文件夹
set MUSIC_DIR "Music_Done"

# 2. 下载记录文件 (防重复下载)
set ARCHIVE_FILE "archive.txt"

# 3. 浏览器 Cookies 来源 (chrome, edge, firefox 等)
# 请修改为你实际使用的浏览器
set COOKIES_BROWSER "chrome"

# 4. 🔥 你的手机存储路径
# 请修改为你手机上的实际路径
set REMOTE_PATH "/sdcard/Music/Bilibili/"

# 多台设备同时连接时填写序列号；只有一台设备时留空
set ADB_SERIAL ""

# 5. B站收藏夹地址与检查范围；修改 PLAYLIST_ITEMS 即可调整默认范围
set DOWNLOAD_URL "https://space.bilibili.com/98752587/favlist?fid=110008587&type=create"
set PLAYLIST_ITEMS "1:100"

# 6. DeepSeek 配置 (供 prv.py 读取)
# OpenAI 兼容地址: https://api.deepseek.com
set -gx DEEPSEEK_BASE_URL "https://api.deepseek.com"
set -gx DEEPSEEK_MODEL "deepseek-v4-flash"
set -gx DEEPSEEK_API_KEY "your_deepseek_api_key_here"
# ===========================================

function print_usage
    echo "用法: ./sync-nusic.fish [数量或 ITEM_SPEC]"
    echo "  不传参数   使用脚本内 PLAYLIST_ITEMS=$PLAYLIST_ITEMS"
    echo "  100        收藏夹前 100 个"
    echo "  51:100     收藏夹第 51 到 100 个"
    echo "  1,3,8      收藏夹第 1、3、8 个"
end

if test (count $argv) -gt 1
    echo "❌ 最多只能传一个收藏夹范围参数。"
    print_usage
    exit 2
end

if test (count $argv) -eq 1
    set requested_items (string trim -- "$argv[1]")
    if contains -- "$requested_items" -h --help
        print_usage
        exit 0
    end
    if string match -qr '^[0-9]+$' -- "$requested_items"
        if test "$requested_items" -lt 1
            echo "❌ 收藏夹数量必须大于 0。"
            exit 2
        end
        set PLAYLIST_ITEMS "1:$requested_items"
    else if string match -qr '^[0-9,:-]+$' -- "$requested_items"
        # 复杂切片由 yt-dlp 最终校验，例如 -5::2、1:20:2、1-10。
        set PLAYLIST_ITEMS "$requested_items"
    else
        echo "❌ 无效的收藏夹范围: $requested_items"
        print_usage
        exit 2
    end
end

# 保留上次未成功同步的文件；只在对应文件 ADB 推送成功后清理。
if not test -d "$MUSIC_DIR"
    mkdir -p "$MUSIC_DIR"
end

# 整条流水线加互斥锁，避免两个实例同时下载、改名和清理。
set SYNC_LOCK_DIR "$MUSIC_DIR/.sync.lock"

function release_sync_lock --on-event fish_exit
    if test -f "$SYNC_LOCK_DIR/pid"
        set -l owner (string trim -- (command cat "$SYNC_LOCK_DIR/pid" 2>/dev/null))
        if test "$owner" = "$fish_pid"
            command rm -f -- "$SYNC_LOCK_DIR/pid"
            command rmdir "$SYNC_LOCK_DIR" 2>/dev/null
        end
    end
end

function acquire_sync_lock
    if command mkdir "$SYNC_LOCK_DIR" 2>/dev/null
        printf '%s\n' "$fish_pid" > "$SYNC_LOCK_DIR/pid"
        return 0
    end

    set -l owner ""
    if test -f "$SYNC_LOCK_DIR/pid"
        set owner (string trim -- (command cat "$SYNC_LOCK_DIR/pid" 2>/dev/null))
    end
    if string match -qr '^[0-9]+$' -- "$owner"; and command kill -0 "$owner" 2>/dev/null
        echo "❌ 另一个同步实例正在运行 (PID $owner)。"
        return 1
    end

    # 上次若被强制终止，锁目录可能遗留；仅删除本工具创建的 pid 文件和空目录。
    command rm -f -- "$SYNC_LOCK_DIR/pid"
    command rmdir "$SYNC_LOCK_DIR" 2>/dev/null
    if not command mkdir "$SYNC_LOCK_DIR" 2>/dev/null
        echo "❌ 无法取得同步锁: $SYNC_LOCK_DIR"
        return 1
    end
    printf '%s\n' "$fish_pid" > "$SYNC_LOCK_DIR/pid"
end

if not acquire_sync_lock
    exit 1
end

echo "========================================"
echo "🚀 B站收藏夹 -> 自动清洗 -> 手机同步"
echo "🎯 本次范围: $PLAYLIST_ITEMS"
echo "========================================"

# --- 步骤 1: 检查 ADB 连接 ---
echo "🔌 [1/4] 检查手机连接..."
set connected_devices (adb devices | awk 'NR > 1 && $2 == "device" {print $1}')
set ADB_ARGS
if test -n "$ADB_SERIAL"
    if not contains -- "$ADB_SERIAL" $connected_devices
        echo "❌ 未找到配置的 ADB 设备: $ADB_SERIAL"
        exit 1
    end
    set ADB_ARGS -s "$ADB_SERIAL"
else if test (count $connected_devices) -eq 0
    echo "❌ 未检测到手机！请插上数据线并确保已开启 USB 调试。"
    exit 1
else if test (count $connected_devices) -gt 1
    echo "❌ 检测到多台手机，请在 ADB_SERIAL 中指定一台:"
    printf '  %s\n' $connected_devices
    exit 1
else
    set ADB_ARGS -s "$connected_devices[1]"
    echo "✅ 手机已连接。"
end

# --- 步骤 2: 下载音频 (yt-dlp) ---
echo "📥 [2/4] 从收藏夹范围 $PLAYLIST_ITEMS 下载新歌..."

# 下载封面和含简介的元数据边车；嵌入与信息提取交给 Python 脚本。
set DOWNLOAD_LOG "$MUSIC_DIR/.yt-dlp-last.log"
set RETRY_LOG "$MUSIC_DIR/.yt-dlp-retry.log"
yt-dlp --cookies-from-browser $COOKIES_BROWSER \
    $DOWNLOAD_URL \
    --playlist-items $PLAYLIST_ITEMS \
    -f 'ba/b' -x --audio-format m4a \
    --output "$MUSIC_DIR/%(title)s [%(id)s].%(ext)s" \
    --write-thumbnail --convert-thumbnails jpg --write-info-json --no-keep-video \
    --download-archive $ARCHIVE_FILE \
    --ignore-errors --no-color 2>&1 | tee "$DOWNLOAD_LOG"

set download_pipeline_status $pipestatus
set download_had_errors 0
set download_log_has_errors 0
if not test -f "$DOWNLOAD_LOG"
    set download_had_errors 1
else if grep -q 'ERROR:' "$DOWNLOAD_LOG"
    set download_log_has_errors 1
end

if test $download_log_has_errors -eq 1
    # B站活动视频的普通 /video/ 页面有时不再包含 yt-dlp 所需状态；
    # 只对这种已知错误查询并校验官方 festival_jump_url 后重试。
    set festival_retry_urls (python3 bilibili_festival_retry.py "$DOWNLOAD_LOG")
    set festival_resolver_status $status
    if test $festival_resolver_status -eq 0; and test (count $festival_retry_urls) -gt 0
        echo "🔁 检测到 "(count $festival_retry_urls)" 个活动页视频，使用官方活动地址重试..."
        yt-dlp --cookies-from-browser $COOKIES_BROWSER \
            $festival_retry_urls \
            --no-playlist \
            -f 'ba/b' -x --audio-format m4a \
            --output "$MUSIC_DIR/%(title)s [%(id)s].%(ext)s" \
            --write-thumbnail --convert-thumbnails jpg --write-info-json --no-keep-video \
            --download-archive $ARCHIVE_FILE \
            --no-color 2>&1 | tee "$RETRY_LOG"

        set retry_pipeline_status $pipestatus
        for pipeline_code in $retry_pipeline_status
            if test "$pipeline_code" -ne 0
                set download_had_errors 1
            end
        end
        if not test -f "$RETRY_LOG"; or grep -q 'ERROR:' "$RETRY_LOG"
            set download_had_errors 1
        end
        if test -f "$RETRY_LOG"
            command cat "$RETRY_LOG" >> "$DOWNLOAD_LOG"
            command rm -f -- "$RETRY_LOG"
        end
    else
        set download_had_errors 1
    end

    # 已知活动页错误可使 yt-dlp 本身返回非零，但 tee 写日志失败不能忽略。
    if test (count $download_pipeline_status) -lt 2; or test "$download_pipeline_status[2]" -ne 0
        set download_had_errors 1
    end
else
    for pipeline_code in $download_pipeline_status
        if test "$pipeline_code" -ne 0
            set download_had_errors 1
        end
    end
end
if test $download_had_errors -ne 0
    echo "⚠️ 下载过程存在失败项；成功项会继续同步，失败项不会写入 archive，下次将重试。"
end

# --- 步骤 3: 运行 Python 强力清洗 ---
echo "🧹 [3/4] 调用 Python 脚本 (清洗文件名 + 拆分歌手 + 统一专辑 + 嵌封面)..."
python3 prv.py
if test $status -ne 0
    echo "❌ 音频处理失败，保留 $MUSIC_DIR 供下次重试。"
    exit 1
end

set music_files (find "$MUSIC_DIR" -maxdepth 1 -type f -name '*.m4a' -print)
if test (count $music_files) -eq 0
    if test $download_had_errors -eq 1
        echo "❌ 本次没有可同步文件，且存在下载失败项；详见 $DOWNLOAD_LOG"
        exit 1
    end
    echo "✅ 没有待同步的新歌曲。"
    exit 0
end

# --- 步骤 4: ADB 同步 ---
echo "📲 [4/4] 逐文件推送到手机..."
set remote_dir (string replace -r '/+$' '' -- "$REMOTE_PATH")
set remote_dir_escaped (string escape -- "$remote_dir")
adb $ADB_ARGS shell "mkdir -p $remote_dir_escaped"
if test $status -ne 0
    echo "❌ 无法创建或访问手机目录，保留全部本地文件。"
    exit 1
end

set push_failed 0
for music_file in $music_files
    set file_name (basename -- "$music_file")
    set remote_file "$remote_dir/$file_name"
    adb $ADB_ARGS push -p "$music_file" "$remote_file"
    if test $status -eq 0
        # 单首成功即提交；若随后崩溃，尚未删除的文件也可安全覆盖重推。
        command rm -f -- "$music_file"
        if test -e "$music_file"
            echo "❌ 推送成功但本地清理失败: $music_file"
            set push_failed 1
        end
    else
        echo "❌ 推送失败，保留供下次重试: $music_file"
        set push_failed 1
    end
end

if test $push_failed -ne 0
    echo "❌ 部分歌曲同步失败；成功项已提交，失败项仍保留在 $MUSIC_DIR。"
    exit 1
end

if test $download_had_errors -ne 0
    echo "⚠️ 已同步本次下载成功的歌曲，但仍有下载失败项需要下次重试。"
    exit 1
end

echo "========================================"
echo "🎉 全部完成！"
echo "👉 1. 请拔掉数据线。"
echo "👉 2. 打开手机 Musicolet -> 点击「扫描」刷新媒体库。"
echo "========================================"
